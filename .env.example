# Local development defaults. Keep real values in private .env files only.
APP_ENV=development
APP_SECRET_KEY=development-only-change-me
DATABASE_URL=sqlite+aiosqlite:///./zvonko-dev.db
REDIS_URL=redis://localhost:6379/0
DEFAULT_TIMEZONE=Europe/Zagreb
ASSISTANT_GRAMMATICAL_GENDER=masculine

# Production requires the four family numbers; Sven is optional.
MAMA_PHONE_E164=
TATA_PHONE_E164=
BRANKO_PHONE_E164=
NATASA_PHONE_E164=
SVEN_PHONE_E164=

TELEPHONY_PROVIDER=development
STT_PROVIDER=development
TTS_PROVIDER=development
LLM_PROVIDER=development
LLM_MODEL=deterministic-hr
PUBLIC_BASE_URL=http://localhost:8000

# For the cloud pilot use twilio / deepgram / azure and a public HTTPS origin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Purchased Twilio number for incoming calls; outbound fallback when no override.
TWILIO_FROM_NUMBER=
# Optional number you own and have already verified with Twilio.
TWILIO_OUTBOUND_CALLER_ID=
TWILIO_RING_TIMEOUT=30
TWILIO_OUTBOUND_ENABLED=false
VOICE_MAX_SECONDS=600
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
# Must exactly match the Azure resource region.
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_VOICE=hr-HR-SreckoNeural
AZURE_SPEECH_RATE_PERCENT=-10

# Hetzner Compose: generate a strong password on the server before first startup.
POSTGRES_PASSWORD=
STORE_TRANSCRIPT_SUMMARIES=false
LOG_LEVEL=INFO
